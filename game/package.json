{
  "name": "rich4-remake",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "description": "High-resolution remake of Rich4 (大富翁4) following the original rules; assets come from the player's own copy.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "assets": "node scripts/link-assets.mjs",
    "build:app": "tsc --noEmit && RICH4_NO_ASSETS=1 vite build && RICH4_WEBP=1 node scripts/bundle-assets.mjs && cap sync ios",
    "ios": "node scripts/install-ios.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/node": "^22.18.11",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/screen-orientation": "7.0.4",
    "@capacitor/share": "7.0.4",
    "@fontsource/huninn": "5.3.1",
    "opencc-js": "1.4.2",
    "peerjs": "1.5.5"
  }
}
